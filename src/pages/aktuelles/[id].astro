---
import { getCollection, render } from 'astro:content';
import QRCode from 'qrcode';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const newsItems = await getCollection('aktuelles');
  return newsItems.map((newsItem) => ({
    params: { id: newsItem.id },
    props: { newsItem },
  }));
}

const { newsItem } = Astro.props;
const { Content } = await render(newsItem);
const { title, summary, date, donationReference } = newsItem.data;
const formattedDate = date.toLocaleDateString('de-DE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const donationRecipient = 'GeTu Prospects e.V.';
const donationIban = 'DE94100100100064071143';
const formattedIban = donationIban.replace(/(.{4})/g, '$1 ').trim();
// EPC069-12 "GiroCode" payload: banking apps fill in the transfer from it.
// Fields are positional, so the empty lines must stay: BIC (optional in
// version 002), amount (left to the donor), purpose code, structured reference.
const giroCodePayload = [
  'BCD',
  '002',
  '1',
  'SCT',
  '',
  donationRecipient,
  donationIban,
  '',
  '',
  '',
  donationReference,
].join('\n');
const giroCodeSvg = donationReference
  ? await QRCode.toString(giroCodePayload, {
      type: 'svg',
      errorCorrectionLevel: 'M',
      margin: 0,
    })
  : '';
---

<BaseLayout title={title} description={summary}>
  {
    donationReference ? (
      <section class="bg-primary text-white">
        <div class="container mx-auto px-8 pt-28 lg:pt-40 pb-16 lg:pb-24">
          <div class="grid lg:grid-cols-[1fr,minmax(0,28rem)] gap-x-16 gap-y-8 lg:gap-y-0">
            <div class="lg:self-end">
              <time
                datetime={date.toISOString()}
                class="text-secondary uppercase tracking-wider text-sm font-medium"
              >
                AKTUELLES · {formattedDate}
              </time>
              <h1 class="text-3xl md:text-5xl font-bold leading-tight mt-4">
                {title}
              </h1>
              <div class="h-1 w-16 bg-secondary mt-6 lg:my-8" />
            </div>

            <aside
              id="spenden"
              class="bg-white text-body p-6 sm:p-8 scroll-mt-32 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center"
            >
              <h2 class="text-primary text-2xl font-bold">
                So können Sie spenden
              </h2>
              <p class="text-sm font-light mt-2">
                Am besten monatlich per Dauerauftrag.
              </p>
              <dl class="space-y-3 mt-6">
                <div class="relative bg-secondary text-white p-4">
                  <dt class="uppercase tracking-wider text-xs font-medium mb-1">
                    Verwendungszweck
                  </dt>
                  <dd class="text-xl font-bold">{donationReference}</dd>
                  <button
                    type="button"
                    data-copy={donationReference}
                    data-copy-name="Verwendungszweck"
                    aria-label="Verwendungszweck kopieren"
                    class="absolute top-3 right-3 text-xs font-medium uppercase tracking-wider bg-white/20 hover:bg-white/30 px-2 py-1"
                  >
                    Kopieren
                  </button>
                </div>
                <div class="relative bg-[var(--tp-grey-1)] p-4">
                  <dt class="text-secondary uppercase tracking-wider text-xs font-medium mb-1">
                    IBAN
                  </dt>
                  <dd class="text-primary text-lg font-medium whitespace-nowrap">
                    {formattedIban}
                  </dd>
                  <button
                    type="button"
                    data-copy={donationIban}
                    data-copy-name="IBAN"
                    aria-label="IBAN kopieren"
                    class="absolute top-3 right-3 text-xs font-medium uppercase tracking-wider text-secondary bg-white hover:bg-secondary hover:text-white px-2 py-1"
                  >
                    Kopieren
                  </button>
                </div>
                <div class="bg-[var(--tp-grey-1)] p-4">
                  <dt class="text-secondary uppercase tracking-wider text-xs font-medium mb-1">
                    Empfänger
                  </dt>
                  <dd class="text-primary text-lg font-medium">
                    {donationRecipient}
                    <span class="block text-body text-sm font-light">
                      Postbank
                    </span>
                  </dd>
                </div>
              </dl>
              <p id="copy-status" class="sr-only" aria-live="polite" />
              <a
                href="#mehr-zum-spenden"
                class="inline-block text-sm text-secondary font-medium mt-5 hover:underline"
              >
                Mehr zum Spenden ↓
              </a>
            </aside>

            <div class="lg:col-start-1 lg:row-start-2 lg:self-start">
              <p class="text-lg md:text-xl font-light leading-relaxed text-gray-100">
                {summary}
              </p>
              <a
                href="#geschichte"
                class="hidden lg:inline-flex items-center text-secondary font-medium mt-8"
              >
                Die ganze Geschichte lesen ↓
              </a>
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="bg-primary text-white">
        <div class="container mx-auto px-8">
          <div class="pt-40 pb-6 text-center">
            <time
              datetime={date.toISOString()}
              class="text-secondary uppercase tracking-wider text-sm font-medium"
            >
              AKTUELLES · {formattedDate}
            </time>
          </div>
          <div class="text-center max-w-4xl mx-auto">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
              {title}
            </h1>
            <div class="flex justify-center">
              <div class="h-1 w-16 bg-secondary mb-12" />
            </div>
          </div>
          <div class="max-w-3xl mx-auto text-center pb-32">
            <p class="text-lg md:text-xl font-light leading-relaxed text-gray-100">
              {summary}
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section id="geschichte" class="py-24 lg:py-32 bg-white scroll-mt-24">
    <div class="container mx-auto px-8">
      <div class="max-w-3xl mx-auto">
        <div class="news-content text-body text-lg font-light leading-relaxed">
          <Content />
        </div>

        {
          donationReference && (
            <div
              id="mehr-zum-spenden"
              class="bg-[var(--tp-grey-1)] p-8 sm:p-10 mt-16 scroll-mt-28"
            >
              <h2 class="text-primary text-2xl font-bold">
                Helfen Sie mit, diesen Dienst zu tragen
              </h2>
              <p class="text-body font-light leading-relaxed mt-3">
                Am meisten hilft ein monatlicher Dauerauftrag, schon ab 10 €.
                Bitte überweisen Sie immer mit dem Verwendungszweck{' '}
                {`„${donationReference}“`}, damit Ihre Spende genau hier
                ankommt.
              </p>
              <div class="hidden lg:flex items-center gap-5 mt-6">
                <div
                  role="img"
                  aria-label="GiroCode für die Überweisung"
                  class="w-28 shrink-0 [&>svg]:w-full [&>svg]:h-auto"
                  set:html={giroCodeSvg}
                />
                <p class="text-sm font-light leading-relaxed">
                  <span class="font-medium text-primary">GiroCode:</span> Mit
                  Ihrer Banking-App scannen. Empfänger, IBAN und
                  Verwendungszweck werden automatisch ausgefüllt.
                </p>
              </div>
              <p class="text-sm font-light leading-relaxed mt-6">
                Auf Wunsch stellen wir Ihnen eine Zuwendungsbestätigung aus.
                Schreiben Sie uns dazu eine E-Mail:{' '}
                <a
                  href="mailto:info@getu-prospects.de"
                  class="text-secondary hover:underline whitespace-nowrap"
                >
                  info@getu-prospects.de
                </a>
              </p>
              <a
                href="#spenden"
                class="inline-block bg-secondary text-white py-4 px-10 font-medium mt-8 transition-all hover:bg-opacity-90"
              >
                Zu den Spendendaten ↑
              </a>
            </div>
          )
        }

        <a
          href="/aktuelles"
          class="inline-flex items-center text-secondary font-medium mt-16"
        >
          ← Alle Neuigkeiten
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const copyStatus = document.getElementById('copy-status')!;
  for (const copyButton of document.querySelectorAll<HTMLButtonElement>(
    '[data-copy]',
  )) {
    const buttonLabel = copyButton.textContent;
    copyButton.addEventListener('click', async () => {
      const copyName = copyButton.dataset.copyName;
      try {
        await navigator.clipboard.writeText(copyButton.dataset.copy ?? '');
        copyButton.textContent = 'Kopiert';
        copyStatus.textContent = `${copyName} kopiert`;
      } catch {
        // Some in-app browsers block the clipboard; the value stays visible.
        copyButton.textContent = 'Bitte manuell kopieren';
        copyStatus.textContent = `${copyName} konnte nicht kopiert werden`;
      }
      setTimeout(() => (copyButton.textContent = buttonLabel), 2000);
    });
  }
</script>

<style>
  .news-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .news-content :global(h2) {
    color: var(--color-primary);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
</style>
