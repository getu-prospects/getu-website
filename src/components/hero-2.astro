---
import { Image } from 'astro:assets';
import StreetFestivalPhoto from '../assets/images/waidmannslust/strassenfest-stand.jpg';
import VolunteerDayPhoto from '../assets/images/ehrenamtstag/buehne-publikum.jpg';
import MentoringPhoto from '../assets/images/mentorship-auftakt/teilnehmende.jpg';
import YouthPhoto from '../assets/images/youth/lerngruppe.jpg';
import ChristmasPhoto from '../assets/images/christmas/getu-ausgabe-4.jpeg';
import NigeriaVisitPhoto from '../assets/images/nigeria-visit/gruppenfoto.jpg';

const slides = [
  {
    image: StreetFestivalPhoto,
    alt: 'Stand von GeTu Prospects mit Banner und gedecktem Tisch beim Fest 150 Jahre Waidmannslust',
  },
  {
    image: VolunteerDayPhoto,
    alt: 'Publikum verfolgt eine Rede auf der Bühne der Reinickendorfer Freiwilligenbörse im Fontane Haus',
  },
  {
    image: MentoringPhoto,
    alt: 'Teilnehmende des Mentoring-Auftakts sitzen im Stuhlkreis und machen sich Notizen',
  },
  {
    image: YouthPhoto,
    alt: 'Jugendliche sitzen mit aufgeschlagenen Büchern an einem Tisch und arbeiten zusammen',
  },
  {
    image: ChristmasPhoto,
    alt: 'Ehrenamtliche verteilen bei der Weihnachtsaktion am Kottbusser Tor Essen',
    position: 'object-[60%_50%]',
  },
  {
    image: NigeriaVisitPhoto,
    alt: 'Gruppenfoto von Mitgliedern und Studierenden aus Nigeria vor dem Vereinsbüro',
    position: 'object-[40%_50%]',
  },
];
---

<section class="relative bg-white grid lg:grid-cols-12 lg:min-h-[80vh]">
  <!-- Text column -->
  <div
    class="relative lg:col-span-5 flex flex-col justify-center px-8 lg:px-16 py-16 lg:pt-36 lg:pb-24"
  >
    <div class="max-w-lg">
      <div class="flex items-center gap-4 mb-8 animate-fade-up">
        <div class="w-12 h-px bg-secondary"></div>
        <span class="text-xs uppercase tracking-[0.2em] text-body font-medium">
          Berlin · Seit 2014
        </span>
      </div>

      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-bold leading-[0.95] animate-fade-up animate-delay-100"
      >
        <span class="block text-primary">Gemeinsam</span>
        <span class="block text-secondary mt-2">Zukunft</span>
        <span class="block text-primary mt-2">gestalten</span>
      </h1>

      <p
        class="mt-8 text-lg text-body leading-relaxed animate-fade-up animate-delay-200"
      >
        Ein interkultureller Verein in Berlin, der Menschen verbindet,
        Jugendliche fördert und Brücken zwischen Kulturen baut.
      </p>

      <div class="mt-10 flex flex-wrap gap-4 animate-fade-up animate-delay-300">
        <a
          href="/kontakt"
          class="inline-flex items-center justify-center gap-2 border-2 border-secondary bg-secondary text-white py-3 px-8 font-medium"
        >
          Engagieren
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            ></path>
          </svg>
        </a>
        <a
          href="/ueber-uns"
          class="inline-flex items-center justify-center border-2 border-primary text-primary py-3 px-8 font-medium"
        >
          Wer wir sind
        </a>
      </div>
    </div>
  </div>

  <!-- Photo slideshow -->
  <div
    class="hero-slideshow order-first lg:order-none lg:col-span-7 relative min-h-[50vh] lg:min-h-[80vh] overflow-hidden bg-primary"
  >
    {slides.map((slide, slideIndex) => (
      <Image
        src={slide.image}
        alt={slide.alt}
        layout="constrained"
        width={1200}
        fit="cover"
        sizes="(min-width: 1024px) 58vw, 100vw"
        priority={slideIndex === 0}
        class:list={[
          'absolute inset-0 w-full h-full max-w-none object-cover',
          slide.position ?? 'object-center',
        ]}
      />
    ))}

    <div
      class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent pointer-events-none"
    ></div>

    <!-- Keeps the header links legible over the photo; the header itself has no gradient on this page -->
    <div
      class="absolute inset-x-0 top-0 h-32 nav-background pointer-events-none"
    ></div>

    <figure
      class="absolute bottom-4 left-4 right-4 sm:bottom-8 sm:left-8 sm:right-8 lg:bottom-12 lg:left-12 lg:right-auto lg:max-w-sm bg-primary/90 backdrop-blur-sm p-4 sm:p-6"
    >
      <blockquote class="text-white/80 text-sm leading-relaxed">
        „Wir glauben an eine Gesellschaft, in der jeder Mensch wertgeschätzt
        wird.“
      </blockquote>
      <figcaption class="mt-3 text-secondary text-xs uppercase tracking-wider">
        — GeTu Prospects e.V.
      </figcaption>
    </figure>

    <div
      class="absolute top-32 right-12 hidden lg:block w-20 h-20 border border-white/30"
    ></div>
  </div>

  <!-- Bottom decorative accent -->
  <div
    class="absolute bottom-0 left-0 right-0 h-2 sm:h-4 bg-secondary z-10"
  ></div>
</section>

<style>
  /* Six slides, 6 s each. A slide fades in over the one before it, so the
     fade-out runs under the next slide and the background never shows. */
  .hero-slideshow :global(img) {
    opacity: 0;
    animation: hero-kenburns 36s infinite;
  }

  .hero-slideshow :global(img:nth-of-type(2)) {
    animation-delay: 6s;
  }
  .hero-slideshow :global(img:nth-of-type(3)) {
    animation-delay: 12s;
  }
  .hero-slideshow :global(img:nth-of-type(4)) {
    animation-delay: 18s;
  }
  .hero-slideshow :global(img:nth-of-type(5)) {
    animation-delay: 24s;
  }
  .hero-slideshow :global(img:nth-of-type(6)) {
    animation-delay: 30s;
  }

  @keyframes hero-kenburns {
    0% {
      opacity: 0;
      transform: scale(1);
    }
    4% {
      opacity: 1;
    }
    16.667% {
      opacity: 1;
    }
    20.667% {
      opacity: 0;
      transform: scale(1.08);
    }
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }

  @keyframes hero-crossfade {
    0% {
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    16.667% {
      opacity: 1;
    }
    20.667% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slideshow :global(img) {
      animation-name: hero-crossfade;
    }
  }
</style>
