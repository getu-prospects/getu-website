---
import { Image } from 'astro:assets';
import VolunteerFairPhoto from '../assets/images/ehrenamtstag/IMG_8725.jpg';
import YouthPhoto from '../assets/images/youth/IMG_7606.jpg';
import MentoringPhoto from '../assets/images/mentorship-auftakt/IMG_8711.jpg';
import StammtischPhoto from '../assets/images/stammtisch-auftakt/IMG_7935.jpg';
import ChristmasPhoto from '../assets/images/christmas/getu-ausgabe-4.jpeg';
import StreetFestivalPhoto from '../assets/images/waidmannslust/IMG_7998.jpg';

const slides = [
  {
    image: VolunteerFairPhoto,
    alt: 'Zwei Mitglieder von GeTu Prospects am Stand des Vereins auf der Reinickendorfer Freiwilligenbörse',
  },
  {
    image: YouthPhoto,
    alt: 'Junge Menschen sitzen mit aufgeschlagenen Büchern an einem Tisch und lachen',
  },
  {
    image: MentoringPhoto,
    alt: 'Teilnehmende des Mentoring-Auftakts verfolgen eine Präsentation',
  },
  {
    image: StammtischPhoto,
    alt: 'Menschen sitzen beim Stammtisch an einer langen, mit Blumen geschmückten Tafel',
  },
  {
    image: ChristmasPhoto,
    alt: 'Ehrenamtliche verteilen bei der Weihnachtsaktion am Kottbusser Tor Essen',
  },
  {
    image: StreetFestivalPhoto,
    alt: 'Stand von GeTu Prospects mit Banner und gedecktem Tisch beim Fest 150 Jahre Waidmannslust',
  },
];
---

<section class="relative flex flex-col lg:grid lg:grid-cols-12 lg:min-h-[85vh]">
  <!-- Text column -->
  <div
    class="order-2 lg:order-1 lg:col-span-6 xl:col-span-5 bg-white flex items-center px-4 sm:px-6 lg:px-0 py-8 sm:py-10 lg:py-16"
  >
    <div class="w-full p-8 sm:p-10 lg:p-12 xl:p-16 animate-fade-down">
      <div class="space-y-6 sm:space-y-8">
        <!-- Organization name -->
        <h6
          class="text-secondary uppercase tracking-widest text-base sm:text-lg font-semibold"
        >
          GETU PROSPECTS E.V.
        </h6>

        <!-- Main headings -->
        <div>
          <h1
            class="text-4xl sm:text-5xl xl:text-6xl font-bold leading-tight text-primary"
          >
            Vielfalt leben
          </h1>
          <h2 class="text-2xl sm:text-3xl font-medium pt-2 text-primary">
            Träume stärken
          </h2>
        </div>

        <!-- Divider -->
        <div class="h-1 w-24 bg-secondary"></div>

        <!-- Description paragraph -->
        <p class="text-base sm:text-lg text-body leading-relaxed">
          Als Interkultureller Verein verbinden wir Kulturen und begleiten
          Familien und junge Menschen dabei, neue Perspektiven im Leben zu
          schaffen.
        </p>

        <!-- Buttons with proper vertical alignment -->
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-4 sm:gap-6 pt-4">
          <a
            href="/ueber-uns#vision"
            class="bg-primary text-white py-3 px-8 sm:py-4 sm:px-10 text-center font-medium transition-all inline-flex items-center justify-center"
            >Unsere Vision</a
          >
          <a
            href="/kontakt"
            class="bg-secondary text-white py-3 px-8 sm:py-4 sm:px-10 text-center font-medium transition-all inline-flex items-center justify-center"
            >Mitmachen</a
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Photo slideshow -->
  <div
    class="order-1 lg:order-2 lg:col-span-6 xl:col-span-7 relative aspect-[4/3] lg:aspect-auto overflow-hidden bg-deepgreen"
    data-hero-slideshow
  >
    {slides.map((slide, slideIndex) => (
      <Image
        src={slide.image}
        alt={slide.alt}
        layout="constrained"
        width={1200}
        fit="cover"
        sizes="(min-width: 1280px) 58vw, (min-width: 1024px) 50vw, 100vw"
        priority={slideIndex === 0}
        aria-hidden={slideIndex === 0 ? undefined : 'true'}
        data-hero-slide
        class:list={[
          'absolute inset-0 w-full h-full max-w-none object-cover opacity-0 transition-opacity duration-1000 motion-reduce:transition-none [&.is-active]:opacity-100',
          slideIndex === 0 && 'is-active',
        ]}
      />
    ))}

    <!-- Keeps the header links legible over the photo; the header itself has no gradient on this page -->
    <div
      class="absolute inset-x-0 top-0 h-32 nav-background pointer-events-none"
    ></div>

    <div
      class="absolute bottom-6 sm:bottom-8 right-4 sm:right-6 z-10 flex bg-primary/70 px-1"
    >
      {slides.map((_, slideIndex) => <button
        type="button"
        aria-label={`Bild ${slideIndex + 1} anzeigen`}
        aria-current={slideIndex === 0 ? 'true' : undefined}
        data-hero-dot
        class="group p-2 cursor-pointer"
      >
        <span
          class="block w-2.5 h-2.5 bg-white transition-colors group-aria-[current=true]:bg-secondary"
        />
      </button>)}
    </div>
  </div>

  <!-- Bottom decorative accent -->
  <div
    class="absolute bottom-0 left-0 right-0 h-2 sm:h-4 bg-secondary z-10"
  ></div>
</section>

<script>
  const SLIDE_INTERVAL_MS = 6000;

  const slideshow = document.querySelector<HTMLElement>(
    '[data-hero-slideshow]',
  );

  if (slideshow) {
    const slideImages = [
      ...slideshow.querySelectorAll<HTMLElement>('[data-hero-slide]'),
    ];
    const dotButtons = [
      ...slideshow.querySelectorAll<HTMLElement>('[data-hero-dot]'),
    ];
    const autoplayAllowed = !window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    let activeIndex = 0;
    let intervalId: number | undefined;

    const showSlide = (nextIndex: number) => {
      activeIndex = nextIndex;
      slideImages.forEach((slideImage, slideIndex) => {
        const isActive = slideIndex === nextIndex;
        slideImage.classList.toggle('is-active', isActive);
        if (isActive) slideImage.removeAttribute('aria-hidden');
        else slideImage.setAttribute('aria-hidden', 'true');
      });
      dotButtons.forEach((dotButton, dotIndex) => {
        if (dotIndex === nextIndex)
          dotButton.setAttribute('aria-current', 'true');
        else dotButton.removeAttribute('aria-current');
      });
    };

    const stopAutoplay = () => {
      window.clearInterval(intervalId);
      intervalId = undefined;
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!autoplayAllowed || document.hidden || slideshow.matches(':hover'))
        return;
      intervalId = window.setInterval(
        () => showSlide((activeIndex + 1) % slideImages.length),
        SLIDE_INTERVAL_MS,
      );
    };

    dotButtons.forEach((dotButton, dotIndex) => {
      dotButton.addEventListener('click', () => {
        showSlide(dotIndex);
        startAutoplay();
      });
    });

    slideshow.addEventListener('mouseenter', stopAutoplay);
    slideshow.addEventListener('mouseleave', startAutoplay);
    document.addEventListener('visibilitychange', startAutoplay);

    startAutoplay();
  }
</script>
