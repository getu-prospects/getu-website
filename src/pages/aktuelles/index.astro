---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const newsItems = (await getCollection('aktuelles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Aktuelles">
  <section class="bg-primary text-white">
    <div class="container mx-auto px-8">
      <div class="pt-40 pb-6 text-center">
        <span
          class="text-secondary uppercase tracking-wider text-sm font-medium"
          >AKTUELLES</span
        >
      </div>

      <div class="text-center">
        <h1
          class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6"
        >
          Neues aus dem Verein
        </h1>
        <div class="flex justify-center">
          <div class="h-1 w-16 bg-secondary mb-12"></div>
        </div>
      </div>

      <div class="max-w-3xl mx-auto text-center pb-32">
        <p class="text-lg md:text-xl font-light leading-relaxed text-gray-100">
          Geschichten, Neuigkeiten und Möglichkeiten, unsere Arbeit zu
          unterstützen.
        </p>
      </div>
    </div>
  </section>

  <section class="py-32 bg-white">
    <div class="container mx-auto px-8">
      <div class="max-w-3xl mx-auto space-y-16">
        {newsItems.map((newsItem) => <article class="bg-(--tp-grey-1)">
          {newsItem.data.image && <a
            href={`/aktuelles/${newsItem.id}`}
            tabindex="-1"
            aria-hidden="true"
          >
            <Image
              src={newsItem.data.image}
              alt=""
              layout="constrained"
              width={768}
              height={432}
              fit="cover"
              sizes="(min-width: 832px) 768px, calc(100vw - 4rem)"
              class="w-full"
            />
          </a>}
          <div class="p-8 sm:p-12">
            <time
              datetime={newsItem.data.date.toISOString()}
              class="text-secondary uppercase tracking-wider text-sm font-medium"
            >
              {newsItem.data.date.toLocaleDateString('de-DE', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </time>
            <h2 class="text-primary text-2xl md:text-3xl font-bold mt-3">
              <a
                href={`/aktuelles/${newsItem.id}`}
                class="hover:text-secondary"
              >
                {newsItem.data.title}
              </a>
            </h2>
            <div class="h-1 w-16 bg-secondary my-6" />
            <p class="text-body font-light leading-relaxed mb-6">
              {newsItem.data.summary}
            </p>
            <a
              href={`/aktuelles/${newsItem.id}`}
              class="group inline-flex items-center text-secondary font-medium"
            >
              Weiterlesen
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-2 transform transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </div>
        </article>)}
      </div>
    </div>
  </section>
</BaseLayout>
