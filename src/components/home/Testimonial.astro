---
// Vision quote section - minimal editorial style
---

<section class="section-padding bg-deepgreen relative overflow-hidden">
  <!-- Decorative geometric elements -->
  <div class="absolute inset-0">
    <div class="absolute top-0 left-0 w-32 h-32 border border-white/10"></div>
    <div
      class="absolute bottom-0 right-0 w-48 h-48 border border-white/10"
    ></div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border border-white/5"
    ></div>
  </div>

  <div class="max-w-[90rem] mx-auto px-6 relative">
    <div class="max-w-4xl mx-auto reveal">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <!-- Quote mark -->
        <div class="lg:col-span-2 lg:text-right">
          <svg
            class="w-20 h-20 text-white/10 inline-block"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
            ></path>
          </svg>
        </div>

        <!-- Quote content -->
        <div class="lg:col-span-10">
          <blockquote
            class="font-bold text-2xl md:text-3xl lg:text-4xl text-white leading-relaxed mb-8"
          >
            Wir träumen von einer Gesellschaft, in der jeder Mensch
            wertgeschätzt, unterstützt und befähigt wird, sein volles Potenzial
            zu entfalten.
          </blockquote>

          <div class="flex items-center gap-4">
            <div class="w-px h-12 bg-white/30"></div>
            <div>
              <span class="block font-bold text-lg text-white">
                GeTu Prospects e.V.
              </span>
              <span
                class="block text-sm text-white/60 uppercase tracking-wider"
              >
                Unsere Vision
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
