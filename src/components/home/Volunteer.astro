---
// Volunteer recruitment section - split editorial layout
import { Image } from 'astro:assets';
import VolunteerPhoto from '../../assets/images/christmas/essen-ausgabe-02.jpg';

const benefits = [
  {
    number: '01',
    title: 'Sinnvolle Arbeit',
    description: 'Gestalte aktiv die Zukunft junger Menschen mit',
    delay: 'animate-delay-200',
  },
  {
    number: '02',
    title: 'Tolle Gemeinschaft',
    description: 'Werde Teil eines engagierten, herzlichen Teams',
    delay: 'animate-delay-300',
  },
  {
    number: '03',
    title: 'Persönliche Entwicklung',
    description: 'Lerne Neues und wachse an deinen Aufgaben',
    delay: 'animate-delay-400',
  },
  {
    number: '04',
    title: 'Flexible Zeiten',
    description: 'Engagiere dich so, wie es zu deinem Leben passt',
    delay: 'animate-delay-500',
  },
];
---

<section class="relative bg-primary overflow-hidden">
  <div class="grid lg:grid-cols-2">
    <!-- Left: Image with quote -->
    <div class="relative min-h-[500px] lg:min-h-[700px] reveal">
      <Image
        src={VolunteerPhoto}
        alt="Freiwillige bei der Essensausgabe der Weihnachtsaktion"
        layout="constrained"
        width={1000}
        fit="cover"
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="absolute inset-0 w-full h-full max-w-none object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-primary via-primary/40 to-transparent"
      ></div>

      <!-- Quote overlay -->
    </div>

    <!-- Right: Content -->
    <div class="flex flex-col justify-center p-8 lg:p-16 xl:p-20">
      <div class="max-w-xl reveal animate-delay-100">
        <span
          class="text-xs font-semibold tracking-widest uppercase text-secondary mb-4 block"
        >
          Mitmachen
        </span>
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-[1.05] mb-6"
        >
          Werde Teil unserer<br />
          <span class="text-secondary">Geschichte</span>
        </h2>

        <p class="text-lg text-white/70 mb-12 leading-relaxed">
          Du möchtest dich ehrenamtlich engagieren und etwas Sinnvolles
          bewirken? Bei uns findest du nicht nur eine Aufgabe, sondern eine
          Gemeinschaft, die dich trägt und inspiriert.
        </p>

        <!-- Benefits - numbered list style -->
        <div class="space-y-6 mb-12">
          {benefits.map((benefit) => <div
            class:list={['flex items-start gap-6 group reveal', benefit.delay]}
          >
            <span
              class="text-3xl font-bold text-secondary/30 group-hover:text-secondary transition-colors"
            >
              {benefit.number}
            </span>
            <div class="flex-1 pt-1">
              <h3
                class="font-bold text-lg text-white mb-1 group-hover:text-secondary transition-colors"
              >
                {benefit.title}
              </h3>
              <p class="text-white/50 text-sm">{benefit.description}</p>
            </div>
          </div>)}
        </div>

        <a
          href="/kontakt"
          class="inline-flex items-center justify-center gap-2 bg-secondary text-white py-5 px-10 font-medium"
        >
          Jetzt Kontakt aufnehmen
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Decorative elements -->
  <div class="absolute bottom-12 right-12 hidden xl:block pointer-events-none">
    <div class="w-32 h-32 border border-white/10"></div>
  </div>
</section>
