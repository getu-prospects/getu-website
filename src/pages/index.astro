---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero2 from '../components/hero-2.astro';
import SiteCallout from '../components/SiteCallout.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import Familienberatung from '../assets/images/services/beratung.jpg';
import Erziehungsbeistand from '../assets/images/services/erziehung.jpg';
import Einzelfallhilfe from '../assets/images/services/hilfe.jpg';
import AboutPhoto from '../assets/images/ehrenamtstag/IMG_8730.jpg';
import YouthPhoto from '../assets/images/youth/IMG_7606.jpg';
import MentoringPhoto from '../assets/images/mentorship-auftakt/IMG_8711.jpg';
import StammtischPhoto from '../assets/images/stammtisch/meeting-01.jpg';
import ChristmasPhoto from '../assets/images/christmas/getu-ausgabe-1.jpeg';

const latestNewsItems = (await getCollection('aktuelles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = [
  {
    id: 'youth',
    title: 'Youth with Perspective',
    tagline: 'Finde deinen Weg',
    description:
      'Ein Programm für junge Menschen, die gemeinsam Antworten auf die großen Fragen des Lebens suchen.',
    image: YouthPhoto,
    imageAlt:
      'Junge Menschen sitzen mit aufgeschlagenen Büchern an einem Tisch',
  },
  {
    id: 'mentorship',
    title: 'Mentoring-Programm',
    tagline: 'Gemeinsam ankommen',
    description:
      'Wir verbinden Neuankömmlinge mit erfahrenen Mentor*innen für den Start in Deutschland.',
    image: MentoringPhoto,
    imageAlt: 'Teilnehmende des Mentoring-Auftakts hören einem Vortrag zu',
  },
  {
    id: 'stammtisch',
    title: 'Stammtisch gegen Einsamkeit',
    tagline: 'Ein offener Treffpunkt',
    description:
      'Ein Raum für Begegnung und echte Gespräche – offen für alle Altersgruppen.',
    image: StammtischPhoto,
    imageAlt: 'Gruppenfoto der Teilnehmenden des Stammtischs',
  },
  {
    id: 'weihnachten',
    title: 'Weihnachtsaktion',
    tagline: 'Hoffnung schenken',
    description:
      'Seit 2016 schenken wir obdachlosen Menschen in Berlin Unterstützung und Wärme.',
    image: ChristmasPhoto,
    imageAlt:
      'Ehrenamtliche mit gefüllten Taschen bei der Weihnachtsaktion am Kottbusser Tor',
  },
];
---

<BaseLayout title="Interkultureller Verein in Berlin" plainHeader>
  <!-- Hero Section with improved layout and spacing -->
  <Hero2 />

  {latestNewsItems.length > 0 && <section class="pt-20">
    <div class="container mx-auto px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h6
          class="text-secondary uppercase tracking-widest text-sm font-semibold mb-4"
        >
          AKTUELLES
        </h6>
        <h2 class="text-3xl md:text-4xl font-bold text-primary">
          Neues aus dem Verein
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestNewsItems.map((newsItem) => <article
          class="bg-(--tp-grey-1) flex flex-col"
        >
          {newsItem.data.image ? (
            <Image
              src={newsItem.data.image}
              alt=""
              layout="constrained"
              width={640}
              height={400}
              fit="cover"
              sizes="(min-width: 768px) 33vw, calc(100vw - 4rem)"
              class="w-full h-56 object-cover"
            />
          ) : (
            <div class="h-56 bg-primary flex items-center justify-center">
              <div class="h-1 w-16 bg-secondary" />
            </div>
          )}
          <div class="p-8 flex flex-col grow">
            <time
              datetime={newsItem.data.date.toISOString()}
              class="text-secondary uppercase tracking-wider text-sm font-medium"
            >
              {newsItem.data.date.toLocaleDateString('de-DE', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
            <h3 class="text-xl font-bold text-primary mt-3">
              <a
                href={`/aktuelles/${newsItem.id}`}
                class="hover:text-secondary"
              >
                {newsItem.data.title}
              </a>
            </h3>
            <div class="h-1 w-16 bg-secondary my-6" />
            <p class="text-body font-light leading-relaxed mb-6">
              {newsItem.data.summary}
            </p>
            <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mt-auto">
              {newsItem.data.donationReference && <a
                href={`/aktuelles/${newsItem.id}#spenden`}
                class="inline-block bg-secondary text-white py-3 px-8 font-medium transition-all"
              >
                Jetzt spenden
              </a>}
              <a
                href={`/aktuelles/${newsItem.id}`}
                class="group inline-flex items-center text-secondary font-medium"
              >
                Weiterlesen
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 ml-2 transform transition-transform duration-300 group-hover:translate-x-1"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
            </div>
          </div>
        </article>)}
      </div>
    </div>
  </section>}

  <!-- Upcoming Events Section - Live Countdown Component -->
  <!-- <UpcomingEvents /> -->

  <!-- About Section with improved layout -->
  <section class="py-36">
    <div class="container mx-auto px-8">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-16 items-center">
        <div class="md:col-span-2 order-2 md:order-1">
          <div class="relative">
            <Image
              src={AboutPhoto}
              alt="Zwei Mitglieder von GeTu Prospects sitzen am Stand des Vereins"
              layout="constrained"
              width={640}
              sizes="(min-width: 768px) 40vw, calc(100vw - 4rem)"
              class="w-full"
            />
            <div
              class="absolute -bottom-8 -left-8 w-16 h-16 bg-secondary hidden md:block"
            ></div>
          </div>
        </div>
        <div class="md:col-span-3 order-1 md:order-2">
          <div class="space-y-10 max-w-2xl">
            <div>
              <h6
                class="text-secondary uppercase tracking-widest text-sm font-semibold mb-4"
              >
                ÜBER UNS
              </h6>
              <h2 class="text-3xl md:text-4xl font-bold text-primary">
                Herz für Menschen.
              </h2>
            </div>

            <div class="h-px w-24 bg-secondary"></div>

            <div class="space-y-6 font-light leading-relaxed text-body">
              <p>
                GeTu Prospects e.V. ist eine Non-Profit-Organisation mit Sitz in
                Berlin. Wir unterstützen Menschen aus verschiedenen Kulturen und
                Ländern bei ihrer Integration in die deutsche Gesellschaft.
              </p>
              <p>
                Wir kennen die Herausforderungen, die jeder im
                Integrationsprozess erlebt. Unsere Stärke liegt darin, dass wir
                gemeinsam arbeiten, um diese Hindernisse zu überwinden und
                persönliches Wachstum zu fördern.
              </p>
              <p>
                In unserer komplexen Welt stehen viele Menschen, besonders
                Kinder und Familien, vor Problemen, die sie allein nicht lösen
                können. Unser Verein bietet die nötige Unterstützung und
                Begleitung auf diesem Weg.
              </p>
            </div>
            <a
              href="/ueber-uns"
              class="group inline-flex items-center text-secondary font-medium"
            >
              Lernen Sie uns kennen
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-2 transform transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section with improved spacing and layout -->
  <section class="bg-tp-grey-1 py-36">
    <div class="container mx-auto px-8">
      <div class="max-w-3xl mx-auto text-center mb-24">
        <h6
          class="text-secondary uppercase tracking-widest text-sm font-semibold mb-4"
        >
          UNSERE LEISTUNGEN
        </h6>
        <h2 class="text-3xl md:text-4xl font-bold text-primary">
          Vielfältige Unterstützung für jede Lebenslage
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
        <!-- Service 1 -->
        <div
          class="bg-white transition-transform hover:-translate-y-2 duration-300"
        >
          <div class="overflow-hidden">
            <img
              src={Erziehungsbeistand.src}
              alt="Erziehungsbeistand"
              class="w-full h-72 object-cover transform transition-transform hover:scale-105 duration-700"
            />
          </div>
          <div class="p-12">
            <h3 class="text-2xl font-bold text-primary mb-8">
              Erziehungsbeistand
            </h3>
            <p class="text-body font-light mb-10 leading-relaxed">
              Mit Erziehung und kontinuierliche Begleitung für Familien durch
              die Entwicklungsphasen.
            </p>
            <span class="hidden md:block text-transparent h-6">&nbsp;</span>
            <a
              href="/erziehungsbeistand"
              class="group inline-flex items-center text-secondary font-medium"
            >
              Mehr erfahren
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-2 transform transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Service 2 -->
        <div
          class="bg-white transition-transform hover:-translate-y-2 duration-300"
        >
          <div class="overflow-hidden">
            <img
              src={Familienberatung.src}
              alt="Familienberatung"
              class="w-full h-72 object-cover transform transition-transform hover:scale-105 duration-700"
            />
          </div>
          <div class="p-12">
            <h3 class="text-2xl font-bold text-primary mb-8">
              Familienberatung
            </h3>
            <p class="text-body font-light mb-10 leading-relaxed">
              Vertrauliche Beratung zur Stärkung familiärer Bindungen und Lösung
              von Konflikten in allen Lebensphasen.
            </p>
            <span class="hidden md:block text-transparent h-6">&nbsp;</span>
            <a
              href="/ueber-uns"
              class="group inline-flex items-center text-secondary font-medium"
            >
              Mehr erfahren
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-2 transform transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Service 3 -->
        <div
          class="bg-white transition-transform hover:-translate-y-2 duration-300"
        >
          <div class="overflow-hidden">
            <img
              src={Einzelfallhilfe.src}
              alt="Einzelfallhilfe"
              class="w-full h-72 object-cover transform transition-transform hover:scale-105 duration-700"
            />
          </div>
          <div class="p-12">
            <h3 class="text-2xl font-bold text-primary mb-8">
              Soziale Programme
            </h3>
            <p class="text-body font-light mb-10 leading-relaxed">
              Gemeinschaftliche Aktivitäten und Workshops, die Austausch und
              Integration zwischen verschiedenen Kulturen fördern.
            </p>
            <!-- <span class="hidden md:block text-transparent h-6">&nbsp;</span> -->
            <a
              href="/ueber-uns"
              class="group inline-flex items-center text-secondary font-medium"
            >
              Mehr erfahren
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-2 transform transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div class="text-center mt-16">
        <a
          href="/ueber-uns#leistungen"
          class="inline-block bg-secondary text-white py-4 px-10 font-medium transition-all"
        >
          Alle Dienstleistungen ansehen
        </a>
      </div>
    </div>
  </section>
  <SiteCallout
    text="Wir träumen von einer Gesellschaft, in der jeder Mensch wertgeschätzt, unterstützt und befähigt wird, sein volles Potenzial zu entfalten."
  />

  <!-- Current Projects Section -->
  <section class="py-32">
    <div class="container mx-auto px-8">
      <div class="max-w-3xl mx-auto text-center mb-20">
        <h6 class="text-secondary font-bold tracking-wider text-lg">
          LAUFENDE PROJEKTE
        </h6>
        <h2 class="text-3xl md:text-4xl font-bold text-primary mt-4">
          Vier Wege, Veränderung zu schaffen
        </h2>
        <p class="text-xl font-light leading-relaxed text-body mt-6">
          Durch gezielte Programme und persönliche Begleitung unterstützen wir
          Menschen auf ihrem Weg zu einem selbstbestimmten Leben.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {projects.map((project) => <div
          class="bg-(--tp-grey-1) flex flex-col transition-transform hover:-translate-y-2 duration-300"
        >
          <div class="overflow-hidden">
            <Image
              src={project.image}
              alt={project.imageAlt}
              layout="constrained"
              width={640}
              height={480}
              fit="cover"
              sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, calc(100vw - 4rem)"
              class="w-full h-56 object-cover transform transition-transform hover:scale-105 duration-700"
            />
          </div>
          <div class="p-8 flex flex-col grow">
            <p
              class="text-secondary uppercase tracking-wider text-sm font-medium mb-3"
            >
              {project.tagline}
            </p>
            <h3 class="text-2xl font-bold text-primary mb-6">
              <a href={`/projekte#${project.id}`} class="hover:text-secondary">
                {project.title}
              </a>
            </h3>
            <p class="text-body font-light mb-8 leading-relaxed">
              {project.description}
            </p>
            <a
              href={`/projekte#${project.id}`}
              class="group inline-flex items-center text-secondary font-medium mt-auto"
            >
              Mehr erfahren
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 ml-2 transform transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </div>
        </div>)}
      </div>
    </div>
  </section>
</BaseLayout>
